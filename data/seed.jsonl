# pr-reviewer-bench 种子数据集：5 个带人工评审意见的真实风格 PR
{"id": "pr-001", "repo": "demo/webapp", "title": "fix: avoid duplicate cache eviction", "diff": "--- a/src/cache.py\n+++ b/src/cache.py\n@@ -10,9 +10,13 @@ def get(key):\n     if key in _store:\n         return _store[key]\n-    value = fetch(key)\n-    _store[key] = value\n+    if key not in _store:\n+        value = fetch(key)\n+        _store[key] = value\n+        evict_if_needed()\n     return value\n", "human_comments": [{"file": "src/cache.py", "line": 13, "body": "这里没加锁，两个线程会同时 fetch，重复驱逐会打乱 LRU 顺序"}]}
{"id": "pr-002", "repo": "demo/webapp", "title": "feat: render user report rows", "diff": "--- a/src/report.py\n+++ b/src/report.py\n@@ -20,6 +20,12 @@ def build_rows(users):\n-    return [row(u) for u in users]\n+    rows = []\n+    for u in users:\n+        profile = db.query(\"SELECT * FROM profiles WHERE id = ?\", u.id)\n+        rows.append(row(u, profile))\n+    return rows\n", "human_comments": [{"file": "src/report.py", "line": 22, "body": "循环里查库是 N+1 问题，一百个用户就是一百次查询，改成一次 IN 查询再在内存里拼"}]}
{"id": "pr-003", "repo": "demo/webapp", "title": "feat: support dynamic hook expressions", "diff": "--- a/src/hooks.py\n+++ b/src/hooks.py\n@@ -5,7 +5,11 @@ def run_hook(expr):\n-    return compile_only(expr)\n+    try:\n+        return eval(expr)\n+    except:\n+        return None\n", "human_comments": [{"file": "src/hooks.py", "line": 6, "body": "eval 直接执行用户输入等于远程代码执行，必须改成白名单解析"}, {"file": "src/hooks.py", "line": 7, "body": "裸 except 会吞掉所有异常，包括 KeyboardInterrupt"}]}
{"id": "pr-004", "repo": "demo/webapp", "title": "fix: handle empty page input", "diff": "--- a/src/pager.py\n+++ b/src/pager.py\n@@ -3,8 +3,10 @@ def page(items, n, size):\n-    return items[n * size:(n + 1) * size]\n+    if items == None:\n+        return []\n+    start = n * size\n+    return items[start:start + size + 1]\n", "human_comments": [{"file": "src/pager.py", "line": 3, "body": "和 None 比较请用 is None"}, {"file": "src/pager.py", "line": 6, "body": "切片多取了一个元素，相邻两页会有重叠，应该是 start + size"}]}
{"id": "pr-005", "repo": "demo/webapp", "title": "refactor: simplify worker loop", "diff": "--- a/src/worker.py\n+++ b/src/worker.py\n@@ -12,6 +12,12 @@ def start(queue):\n-    handle(queue.get())\n+    while True:\n+        item = queue.get()\n+        # TODO: 加超时和退出条件\n+        handle(item)\n+        time.sleep(0.1)\n", "human_comments": [{"file": "src/worker.py", "line": 12, "body": "while True 没有退出条件，进程停不下来，需要加哨兵值"}]}
